                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuErpCode\": \"11797\",\n  \"name\": \"Meatigo Hot Wings 250g\",\n  \"eanCode\": null,\n  \"hsnCode\": \"02071400\",\n  \"uom\": \"PKT\",\n  \"agreedRate\": 126.667,\n  \"mrp\": 175,\n  \"priceTolerance\": 0.05\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/masters/sku",
              "host": ["{{baseUrl}}"],
              "path": ["masters", "sku"]
            }
          }
        },
        {
          "name": "Get All SKUs",
