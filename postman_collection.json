            ],
            "url": {
              "raw": "{{baseUrl}}/masters/sku",
              "host": ["{{baseUrl}}"],
              "path": ["masters", "sku"]
            }
          }
        },
        {
          "name": "Search SKUs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/masters/sku?search=chicken",
              "host": ["{{baseUrl}}"],
              "path": ["masters", "sku"],
              "query": [
                {
                  "key": "search",
                  "value": "chicken"
                }
              ]
            }
          }
        },
        {
          "name": "Get SKU by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/masters/sku/:id",
              "host": ["{{baseUrl}}"],
              "path": ["masters", "sku", ":id"]
            }
          }
        },
        {
          "name": "Update SKU",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agreedRate\": 130,\n  \"mrp\": 180\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/masters/sku/:id",
              "host": ["{{baseUrl}}"],
              "path": ["masters", "sku", ":id"]
            }
          }
        },
        {
          "name": "Delete SKU",
          "request": {
            "method": "DELETE",
            "header": [
